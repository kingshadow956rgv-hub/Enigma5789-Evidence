    // --- 3D THREE.JS GLOBE ENGINE ---
    function init3DGlobe() {
      const container = document.getElementById('globeContainer');
      const width = container.clientWidth;
      const height = container.clientHeight;

      globeScene = new THREE.Scene();
      globeCamera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
      globeCamera.position.z = 280;

      globeRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      globeRenderer.setSize(width, height);
      globeRenderer.setPixelRatio(window.devicePixelRatio);
      container.appendChild(globeRenderer.domElement);

      globeGroup = new THREE.Group();
      globeScene.add(globeGroup);

      // Base Obsidian Globe Sphere
      const geometry = new THREE.SphereGeometry(80, 64, 64);
      const material = new THREE.MeshPhongMaterial({
        color: 0x111317,
        emissive: 0x07080a,
        wireframe: false,
        shininess: 25
      });
      globeSphere = new THREE.Mesh(geometry, material);
      globeGroup.add(globeSphere);

      // Golden Latitude / Longitude Wireframe Grid
      const wireGeo = new THREE.SphereGeometry(80.5, 32, 16);
      const wireMat = new THREE.MeshBasicMaterial({
        color: 0xC5A15B,
        wireframe: true,
        transparent: true,
        opacity: 0.15
      });
      const wireMesh = new THREE.Mesh(wireGeo, wireMat);
      globeGroup.add(wireMesh);

      // Outer Atmosphere Glow Ring
      const atmoGeo = new THREE.SphereGeometry(86, 32, 32);
      const atmoMat = new THREE.MeshBasicMaterial({
        color: 0x00F0FF,
        transparent: true,
        opacity: 0.05,
        side: THREE.BackSide
      });
      const atmoMesh = new THREE.Mesh(atmoGeo, atmoMat);
      globeGroup.add(atmoMesh);

      // Lighting
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
      globeScene.add(ambientLight);

      const dirLight = new THREE.DirectionalLight(0xC5A15B, 1.2);
      dirLight.position.set(200, 100, 150);
      globeScene.add(dirLight);

      // Add Pins/Nodes for Nations
      NATIONS_DATA.forEach(nation => {
        addNationMarker(nation);
      });

      // Add Sample Escalation Arcs
      addThreatArc(38.89, -77.03, 35.68, 139.65, 0x00F0FF); // USA to Japan
      addThreatArc(31.76, 35.21, 35.68, 51.38, 0xFF2A54);  // Israel to Iran
      addThreatArc(50.85, 4.35, 55.75, 37.61, 0xFFB000);   // EU to Russia

      // Mouse Drag Controls
      let isDragging = false;
      let previousMousePosition = { x: 0, y: 0 };

      container.addEventListener('mousedown', e => {
        isDragging = true;
        previousMousePosition = { x: e.clientX, y: e.clientY };
      });

      container.addEventListener('mousemove', e => {
        if (!isDragging) return;
        const deltaMove = {
          x: e.clientX - previousMousePosition.x,
          y: e.clientY - previousMousePosition.y
        };

        globeGroup.rotation.y += deltaMove.x * 0.005;
        globeGroup.rotation.x += deltaMove.y * 0.005;

        previousMousePosition = { x: e.clientX, y: e.clientY };
      });

      window.addEventListener('mouseup', () => { isDragging = false; });

      // Touch handling
      container.addEventListener('touchstart', e => {
        if (e.touches.length === 1) {
          isDragging = true;
          previousMousePosition = { x: e.touches[0].clientX, y: e.touches[0].clientY };
        }
      });
      container.addEventListener('touchmove', e => {
        if (!isDragging || e.touches.length !== 1) return;
        const deltaMove = {
          x: e.touches[0].clientX - previousMousePosition.x,
          y: e.touches[0].clientY - previousMousePosition.y
        };
        globeGroup.rotation.y += deltaMove.x * 0.005;
        globeGroup.rotation.x += deltaMove.y * 0.005;
        previousMousePosition = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      });
      container.addEventListener('touchend', () => { isDragging = false; });

      // Start Animation Loop
      animateGlobe();
    }

    function latLonToVector3(lat, lon, radius) {
      const phi = (90 - lat) * (Math.PI / 180);
      const theta = (lon + 180) * (Math.PI / 180);
      const x = -(radius * Math.sin(phi) * Math.cos(theta));
      const z = (radius * Math.sin(phi) * Math.sin(theta));
      const y = (radius * Math.cos(phi));
      return new THREE.Vector3(x, y, z);
    }

    function addNationMarker(nation) {
      const pos = latLonToVector3(nation.lat, nation.lon, 81);
      
      let color = 0x00F0FF; // Stable
      if (nation.riskScore > 75) color = 0xFF2A54; // High Risk
      else if (nation.riskScore > 50) color = 0xFFB000; // Moderate

      const nodeGeo = new THREE.SphereGeometry(1.8, 16, 16);
      const nodeMat = new THREE.MeshBasicMaterial({ color: color });
      const nodeMesh = new THREE.Mesh(nodeGeo, nodeMat);
      nodeMesh.position.copy(pos);
      nodeMesh.userData = nation;

      globeGroup.add(nodeMesh);
    }

    function addThreatArc(lat1, lon1, lat2, lon2, colorHex) {
      const p1 = latLonToVector3(lat1, lon1, 81);
      const p2 = latLonToVector3(lat2, lon2, 81);

      // Midpoint pulled outward
      const mid = p1.clone().add(p2).multiplyScalar(0.5);
      const dist = p1.distanceTo(p2);
      mid.normalize().multiplyScalar(81 + dist * 0.25);

      const curve = new THREE.QuadraticBezierCurve3(p1, mid, p2);
      const points = curve.getPoints(40);
      const curveGeo = new THREE.BufferGeometry().setFromPoints(points);

      const curveMat = new THREE.LineBasicMaterial({
        color: colorHex,
        transparent: true,
        opacity: 0.75,
        linewidth: 2
      });

      const line = new THREE.Line(curveGeo, curveMat);
      globeGroup.add(line);
    }

    function animateGlobe() {
      requestAnimationFrame(animateGlobe);

      if (isRotating && globeGroup) {
        // Natural counter-clockwise rotation (West to East)
        globeGroup.rotation.y += 0.0015;
