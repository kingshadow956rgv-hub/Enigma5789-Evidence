    // --- YAXCHE WORLD TREE CANVAS ---
    function initYaxcheCanvas() {
      const canvas = document.getElementById('yaxcheCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const rect = canvas.parentElement.getBoundingClientRect();
      canvas.width = rect.width;
      canvas.height = rect.height;

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const rootX = canvas.width / 2;
      const rootY = canvas.height - 60;

      // Draw Tree Trunk
      ctx.strokeStyle = '#C5A15B';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(rootX, rootY);
      ctx.lineTo(rootX, rootY - 140);
      ctx.stroke();

      // Branch Nodes
      const nodes = [
        { name: 'Root Present (Kin 148)', x: rootX, y: rootY - 140, prob: '100%', color: '#C5A15B' },
        { name: 'Branch A: Diplomatic Resolution', x: rootX - 180, y: rootY - 260, prob: '42%', color: '#00FF9D' },
        { name: 'Branch B: Regional Conflict Escalation', x: rootX - 60, y: rootY - 280, prob: '24%', color: '#FF2A54' },
        { name: 'Branch C: Global Economic Transition', x: rootX + 60, y: rootY - 280, prob: '18%', color: '#FFB000' },
        { name: 'Branch D: Technological Breakthrough', x: rootX + 180, y: rootY - 260, prob: '9%', color: '#00F0FF' }
      ];

      // Connect Root to Branches
      nodes.slice(1).forEach(node => {
        ctx.strokeStyle = node.color;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(rootX, rootY - 140);
        ctx.quadraticCurveTo(rootX, rootY - 200, node.x, node.y);
        ctx.stroke();
      });

      // Draw Node Circles & Labels
      nodes.forEach(node => {
        ctx.fillStyle = node.color;
        ctx.beginPath();
        ctx.arc(node.x, node.y, 8, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = '#F0E0CE';
        ctx.font = '11px Space Grotesk';
        ctx.textAlign = 'center';
        ctx.fillText(`${node.name} (${node.prob})`, node.x, node.y - 14);
      });
    }

    // --- TZOL'KIN CALENDAR WHEEL CANVAS ---
    function initTzolkinCanvas() {
      const canvas = document.getElementById('tzolkinCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const rect = canvas.parentElement.getBoundingClientRect();
      canvas.width = rect.width;
      canvas.height = rect.height;

      const centerX = canvas.width / 2;
      const centerY = canvas.height / 2;

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Outer Ring
      ctx.strokeStyle = '#C5A15B';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.arc(centerX, centerY, 140, 0, Math.PI * 2);
      ctx.stroke();

      // Inner Ring
      ctx.strokeStyle = '#00F0FF';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(centerX, centerY, 90, 0, Math.PI * 2);
      ctx.stroke();

      // Center Eye Symbol
      ctx.fillStyle = '#E5C178';
      ctx.font = '24px Cinzel Decorative';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('👁', centerX, centerY);

      // Glyphs Spoke Marks
      for (let i = 0; i < 20; i++) {
        const angle = (i * Math.PI) / 10;
        const x1 = centerX + Math.cos(angle) * 125;
        const y1 = centerY + Math.sin(angle) * 125;
        const x2 = centerX + Math.cos(angle) * 140;
        const y2 = centerY + Math.sin(angle) * 140;

        ctx.strokeStyle = '#C5A15B';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();
      }
    }

