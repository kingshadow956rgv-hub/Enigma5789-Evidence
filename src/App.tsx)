const GMT_CORRELATION = 584283;
const DAY_SIGNS = [
  "Imix'", "Ik'", "Ak'bal", "K'an", "Chikchan",
  "Kimi", "Manik'", "Lamat", "Muluk", "Ok",
  "Chuwen", "Eb'", "Ben", "Ix", "Men",
  "K'ib'", "Kab'an", "Etz'nab'", "Kawak", "Ajaw",
] as const;

function julianDayNumber(year: number, month: number, day: number): number {
  const a = Math.floor((14 - month) / 12);
  const y = year + 4800 - a;
  const m = month + 12 * a - 3;
  return (
    day + Math.floor((153 * m + 2) / 5) + 365 * y +
    Math.floor(y / 4) - Math.floor(y / 100) + Math.floor(y / 400) - 32045
  );
}

function mod(n: number, m: number): number {
  return ((n % m) + m) % m;
}

function getTzolkin(date: Date) {
  const jdn = julianDayNumber(date.getUTCFullYear(), date.getUTCMonth() + 1, date.getUTCDate());
  const daysSinceCreation = jdn - GMT_CORRELATION;
  const position = mod(daysSinceCreation + 159, 260);
  const tone = (position % 13) + 1;
  const sign = DAY_SIGNS[position % 20];
  const bars = Math.floor(tone / 5);
  const dots = tone % 5;
  const barDot = `${dots > 0 ? '·'.repeat(dots) : ''} ${bars > 0 ? '— '.repeat(bars) : ''}`.trim();
  return { fullName: `${tone} ${sign}`, barDot, jdn };
}

